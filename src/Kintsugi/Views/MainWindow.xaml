<Window x:Class="Kintsugi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kintsugi" Width="640" SizeToContent="Height" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Icon="/Resources/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="28,22,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/Resources/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Kintsugi" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,1,0,0">
                    <Run Text="Memory Integrity" /><Run Text="  ·  " Foreground="{StaticResource GoldBrush}" /><Run Text="Kernel Stack Protection" />
                </TextBlock>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;"
                    ToolTip="Refresh status" Click="Refresh_Click" VerticalAlignment="Top" />
        </Grid>

        <!-- Busy indicator + restart banner -->
        <StackPanel Grid.Row="1" Margin="28,0,28,0">
            <ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                         Background="Transparent" BorderThickness="0" Visibility="Hidden" />
            <Border x:Name="RestartBanner" Background="{StaticResource WarnBgBrush}" BorderBrush="#4DF2B84B" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Text="Restart Windows to apply your changes." />
                    <Button Grid.Column="2" Content="Restart now" Click="Restart_Click" Padding="12,5" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,0,28,22">
            <StackPanel>

                <!-- Protection -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Protection" Margin="4,10,0,8" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="22" VerticalAlignment="Top" Margin="0,2,16,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource TitleText}" Text="Memory Integrity" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,0"
                                       Text="Uses virtualization to stop untrusted or malicious code from loading into the Windows kernel (HVCI)." />
                        </StackPanel>
                        <Border x:Name="MiPill" Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,16,0">
                            <TextBlock x:Name="MiPillText" Text="Checking…" />
                        </Border>
                        <CheckBox x:Name="MiToggle" Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Tag="MemoryIntegrity" Click="Toggle_Click" AutomationProperties.Name="Memory Integrity" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="22" VerticalAlignment="Top" Margin="0,2,16,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource TitleText}" Text="Kernel Stack Protection" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,0"
                                       Text="Uses hardware shadow stacks to block return-address attacks in the kernel. Requires Memory Integrity." />
                        </StackPanel>
                        <Border x:Name="KspPill" Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,16,0">
                            <TextBlock x:Name="KspPillText" Text="Checking…" />
                        </Border>
                        <CheckBox x:Name="KspToggle" Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Tag="KernelStackProtection" Click="Toggle_Click" AutomationProperties.Name="Kernel Stack Protection" />
                    </Grid>
                </Border>

                <!-- System -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="System" />
                <Border Style="{StaticResource Card}">
                    <Grid x:Name="SystemGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Virtualization-based security" />
                        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Hardware virtualization" />
                        <TextBlock Grid.Row="2" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Hardware shadow stacks" />
                        <TextBlock Grid.Row="3" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Processor" />
                        <TextBlock Grid.Row="4" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Windows" />
                        <TextBlock Grid.Row="5" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="Device Guard policies" />

                        <TextBlock x:Name="VbsValue" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="…" />
                        <TextBlock x:Name="VirtValue" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="…" />
                        <TextBlock x:Name="ShadowValue" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="…" />
                        <TextBlock x:Name="CpuValue" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" Text="…" />
                        <TextBlock x:Name="WindowsValue" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="…" />
                        <TextBlock x:Name="PolicyValue" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="…" />
                    </Grid>
                </Border>

                <!-- Tools -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Tools" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScanButton" Click="Scan_Click" Padding="14,10"
                            ToolTip="Look for installed drivers commonly reported as incompatible with Memory Integrity.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Scan for driver conflicts" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestorePointButton" Grid.Column="2" Click="RestorePoint_Click" Padding="14,10"
                            ToolTip="Create a System Restore point you can roll back to if Windows fails to start.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Create restore point" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Activity log -->
                <Grid Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Activity log" Margin="4,8,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy log" Click="CopyLog_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear log" Click="ClearLog_Click" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="150" />

                <TextBlock Style="{StaticResource BodyText}" FontSize="11" Margin="4,14,0,0" Opacity="0.8">
                    <Run x:Name="VersionRun" Text="Kintsugi" /><Run Text=" · Unofficial tool, not affiliated with or endorsed by Microsoft." />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
