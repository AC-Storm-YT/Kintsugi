<Window x:Class="Kintsugi.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Icon="/Resources/app.ico" Title="Kintsugi" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,10" />
                <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                    <TextBlock x:Name="Message" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20" Margin="0,0,14,0" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" MinWidth="100" Margin="0,0,8,0" Click="Secondary_Click" IsCancel="True" />
                <Button x:Name="PrimaryButton" MinWidth="100" Style="{StaticResource AccentButton}" Click="Primary_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
